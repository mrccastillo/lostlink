# Copy this file to .env.local. Never commit real credentials.
# MongoDB Atlas or a replica set is required for auth transactions.
MONGODB_URI=
MONGODB_DB=lostlink

# Generate with: node -e "console.log(require('node:crypto').randomBytes(32).toString('base64'))"
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# Brevo transactional email. Use the plain address of a verified Brevo sender.
BREVO_API_KEY=
BREVO_SENDER_EMAIL=

# Cloudinary product environment credentials. Server-only; never use NEXT_PUBLIC_.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
