# Copy this file to .env.local. Never commit real credentials.
# MongoDB Atlas or a replica set is required for auth transactions.
MONGODB_URI=
MONGODB_DB=lostlink

# Generate with: node -e "console.log(require('node:crypto').randomBytes(32).toString('base64'))"
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# Verification and recovery emails use a verified Resend sender domain.
RESEND_API_KEY=
AUTH_EMAIL_FROM=

# Optional comma-separated, exact email domains approved for membership.
# Leave blank to require staff approval of every new member.
AUTH_ALLOWED_EMAIL_DOMAINS=
